{
  "name": "power-meter",
  "version": "0.1.0",
  "private": true,
  "description": "多平台 AI 账户余额 / 积分看板，聚焦「最快到期」优先消耗",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "probe": "tsx src/cli/probe.ts",
    "capture": "tsx src/cli/capture.ts",
    "chrome:debug": "tools/chrome-debug.sh",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
