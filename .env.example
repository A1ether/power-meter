# 复制为 .env 后填写；.env 已被 .gitignore 忽略
# 推荐做法：不要手填，直接 `npm run chrome:debug` + 登录 + `npm run capture` 自动抓取

# ---- 服务配置 ----
PORT=48213
HOST=127.0.0.1
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_MS=12000
EXPIRY_CRITICAL_DAYS=5
EXPIRY_WARNING_DAYS=14
ACCOUNTS_PATH=./accounts.json
# 直连兜底：本机用 TUN 代理（Clash / FlClash / mihomo）出网时，个别站点会被出口节点
# 在 TLS 握手阶段重置（卡片报「请求失败：fetch failed」）。默认 auto = 首次请求遇到
# 网络层失败时，改用「物理网卡源地址 + DoH 真实 IP」重发一次同样的请求。
# 想完全关闭（行为回到引入本开关之前）就设为 off。
DIRECT_EGRESS_RETRY=auto
# 看板的「本机特权接口」（读取托管密钥、增删 A1etherOpenAi 账号）默认只允许本机访问。
# 只有在服务前面已有反向代理鉴权时，才把它设为 1。
# ALLOW_SECRET_REVEAL=0

# ---- 凭证：在 accounts.json 中用 ${VAR} 引用，避免明文入库 ----
# 首选：看板卡片上的「＋ 登录 / 添加账号」→「扫码 / 打开链接登录」，
#       授权成功后自动写入下面这些变量并注册账号（一个账号一张卡片），无需手工填写。
# 下面的 Cookie / 令牌变量是兜底方式，二选一即可（Cookie 优先）。

# Qoder 国内版（qoder.com.cn / qoder.cn）：浏览器登录态 Cookie
QODER_COOKIE=
# 扫码登录写入（设备令牌）：accessToken 取数，refreshToken 续期（自动写回，无需维护）
QODER_ACCESS_TOKEN=
QODER_REFRESH_TOKEN=

# Qoder 国际版（qoder.com，独立平台 provider: qoder-intl）：单独一份登录态，与国内版互不通用
#   抓取：npm run capture -- qoder-intl
#   或在看板国际版卡片「＋ 登录 / 添加账号」里直接扫码
#   国际版账号的凭证一律写这里（看板添加 / 扫码登录会自动选对变量，无需手填）
QODER_GLOBAL_COOKIE=
QODER_GLOBAL_ACCESS_TOKEN=
QODER_GLOBAL_REFRESH_TOKEN=

# Trae（trae.cn）：浏览器登录态 Cookie。JWT 会用它自动续签，无需手工维护
TRAE_COOKIE=
# 「打开链接登录」写入：Cloud-IDE-JWT + refreshToken + 设备私钥（EC P-256，PKCS8 PEM 的 base64）。
# 三者配套使用；设备私钥用于刷新时的 DeviceProof 签名，换机器后需重新登录
TRAE_ACCESS_TOKEN=
TRAE_REFRESH_TOKEN=
TRAE_DEVICE_KEY=

# Trae 国际版（trae.ai，独立平台 provider: trae-global）：单独一份登录态，与国内版互不通用
#   抓取：npm run capture -- trae-global（兼容写法 --site global）
#   或在看板国际版卡片「＋ 登录 / 添加账号」里点「打开链接登录」
#   国际版账号的凭证一律写这里（看板添加 / 登录会自动选对变量，无需手填）
TRAE_GLOBAL_COOKIE=
TRAE_GLOBAL_ACCESS_TOKEN=
TRAE_GLOBAL_REFRESH_TOKEN=
TRAE_GLOBAL_DEVICE_KEY=

# CodeBuddy（www.codebuddy.cn）：必须包含 www 子域下的会话 Cookie
CODEBUDDY_COOKIE=
# 「扫码登录」写入（腾讯插件认证令牌）：accessToken 取数，refreshToken 续期（自动写回）
CODEBUDDY_ACCESS_TOKEN=
CODEBUDDY_REFRESH_TOKEN=

# WorkBuddy 国际版（codebuddy.ai，独立平台 provider: codebuddy-intl）：单独一份登录态，与国内版互不通用
#   抓取：npm run capture -- codebuddy-intl
#   或在看板国际版卡片「＋ 登录 / 添加账号」里扫码 / 网页端登录
#   国际版账号的凭证一律写这里（看板添加 / 登录会自动选对变量，无需手填）
CODEBUDDY_GLOBAL_COOKIE=
CODEBUDDY_GLOBAL_ACCESS_TOKEN=
CODEBUDDY_GLOBAL_REFRESH_TOKEN=
# 国际站若有独立插件后端，用它覆盖默认的 www.workbuddy.ai（一般不需要）
CODEBUDDY_GLOBAL_PLUGIN_BASE=

# CodeArts 华为云：两种凭证任选其一（AK/SK 优先）
# ① 推荐：AK/SK（长期有效，不会像登录态那样过期）
#    在华为云 IAM →「我的凭证 → 访问密钥」创建；只填这两个变量即可，
#    accounts.json 的 codearts 条目即使不写 accessKey/secretKey 也会自动读取：
#      CODEARTS_AK=            # 也兼容 CLI 官方的 CODEARTS_CLI_AK
#      CODEARTS_SK=            # 也兼容 CLI 官方的 CODEARTS_CLI_SK
#    调试用：npm run codearts:aksk-probe（只读探测，输出脱敏）
CODEARTS_AK=
CODEARTS_SK=
# ② 兼容：控制台登录态 Cookie（需含 devclouddevuibjJ_SESSION_ID 与 devclouddevuibjtcftk）
#    华为云会话超时默认 1 小时，过期后需重跑 npm run capture；配置了 AK/SK 时不再使用它
CODEARTS_COOKIE=

# MiniMax Code（agent.minimax.cn）
# ① 扫码登录（推荐）：写入 OAuth 令牌，accessToken 临近过期会自动续期并更新下面两个变量
MINIMAX_ACCESS_TOKEN=
MINIMAX_REFRESH_TOKEN=
# ② 网页端登录 / capture：请求头 token（localStorage `_token`）+ SSO 会话 Cookie +
#    公共参数要求的真实身份（user_id / op_ticket / uuid），缺一不可。
#    推荐直接点卡片上的「网页端登录」，或先在该窗口登录 agent.minimax.cn 再跑
#    `npm run capture -- minimax`，它会一次性把下面这些键全部抓取到位。
MINIMAX_CODE_TOKEN=
MINIMAX_COOKIE=
# user_id 是 18 位大整数，务必保持字符串原样（capture 已按字符串抓取）
MINIMAX_USER_ID=
# 以下两个仅在 localStorage 里存在时才会被写入；accounts.json 里按需引用 opTicket
MINIMAX_OP_TICKET=
MINIMAX_PARAM_TOKEN=
MINIMAX_UUID=

# 商汤小浣熊（xiaohuanxiong.com）：接口只认 Authorization: Bearer，令牌就在网页登录态 Cookie 里
# （xhx_token 优先，其次 raccoon_token）。推荐不要手填，二选一：
#   ① 看板卡片上的「网页端登录」（自动打开调试 Chrome，登录后自动落库）
#   ② npm run capture -- xiaohuanxiong（先在该窗口登录并停在「资源用量」页）
# 三个变量会一起写入：Cookie 留作会话旁证，TOKEN 是真正取数用的，REFRESH_TOKEN 用于过期续期。
XIAOHUANXIONG_COOKIE=
XIAOHUANXIONG_TOKEN=
XIAOHUANXIONG_REFRESH_TOKEN=

# 千问办公（qwenwork.cn）：鉴权只认网页登录态 Cookie（生产环境不带 Authorization）。
# 推荐不要手填，二选一：
#   ① 看板卡片上的「网页端登录」（自动打开调试 Chrome，登录后自动落库）
#   ② npm run capture -- qwenwork（先在该窗口登录并停在「用量明细」页）
QWENWORK_COOKIE=

# A1etherOpenAi（d1v.ai）：不需要 Cookie，用 API 密钥。
# 推荐不要手工填这两个变量，直接跑：
#   npm run a1etheropenai:add -- <账号密钥> <项目密钥>
# 它会先验证两把密钥、自动挑槽位写入、备份原文件，写完即热加载。
# 下面的空槽位就是留给它的：没有空槽位时它会自动用下一个字母（A1etherOpenAi_C_...）。
#   API_KEY   = 个人账号密钥，在 https://www.d1v.ai/settings?tab=api-key 创建（sk- 开头），用于查余额
#   PAI_API_KEY = 项目环境密钥，在项目 Dashboard 的 Create Project Environment 后复制，用于调模型
#                 它没有查询余额的权限，交给看板托管仅为方便「一键复制」
# 注意：看板对 A1etherOpenAi 显示的单位是 QUOTA，不是钱包 USD。
#       quota 才是平台真正会扣的额度（1 USD = 500,000 quota）；
#       钱包 USD 会系统性虚高，quota 归零后即使钱包还有钱也调不动。
# 多个账号就按 A / B / C 继续往下加，并在 accounts.json 里各自写一条 provider: "a1etheropenai"
A1etherOpenAi_A_API_KEY=
A1etherOpenAi_A_PAI_API_KEY=
A1etherOpenAi_B_API_KEY=
A1etherOpenAi_B_PAI_API_KEY=
