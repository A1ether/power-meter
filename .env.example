# 复制为 .env 后填写；.env 已被 .gitignore 忽略
# 服务监听地址
PORT=8787
HOST=127.0.0.1

# 全局缓存 TTL（秒），默认 300（与 token-monitor 保持一致）
CACHE_TTL_SECONDS=300

# 单次请求超时（毫秒）
REQUEST_TIMEOUT_MS=12000

# 到期高亮阈值（天）
EXPIRY_CRITICAL_DAYS=7
EXPIRY_WARNING_DAYS=30

# 账号配置文件路径（默认 ./accounts.json）
ACCOUNTS_PATH=./accounts.json

# ---- 凭证：在 accounts.json 中用 ${VAR} 引用，避免明文入库 ----
QODER_COOKIE=
TRAE_ACCESS_TOKEN=
TRAE_DEVICE_ID=
CODEBUDDY_COOKIE=
CODEARTS_COOKIE=
