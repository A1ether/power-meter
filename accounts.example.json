{
  "_comment": [
    "复制为 accounts.json 后按需修改（该文件已被 .gitignore 忽略）。",
    "推荐流程：npm run chrome:debug → 在弹出窗口登录 → npm run capture 自动抓取凭证。",
    "credentials 用 ${ENV_VAR} 引用 .env，避免把凭证明文写进文件。",
    "保存后服务会自动热加载，无需重启。",
    "provider 支持：qoder / trae / codebuddy / codearts / custom / demo:*"
  ],
  "accounts": [
    {
      "provider": "qoder",
      "displayName": "Qoder",
      "enabled": true,
      "credentials": {
        "cookie": "${QODER_COOKIE}"
      },
      "options": {
        "site": "cn"
      }
    },
    {
      "provider": "trae",
      "displayName": "Trae",
      "enabled": true,
      "credentials": {
        "cookie": "${TRAE_COOKIE}"
      },
      "options": {}
    },
    {
      "provider": "codebuddy",
      "displayName": "CodeBuddy",
      "enabled": true,
      "credentials": {
        "cookie": "${CODEBUDDY_COOKIE}"
      },
      "options": {}
    },
    {
      "provider": "codearts",
      "displayName": "CodeArts 华为云",
      "enabled": true,
      "credentials": {
        "cookie": "${CODEARTS_COOKIE}"
      },
      "options": {}
    },
    {
      "provider": "custom",
      "displayName": "自建/第三方平台示例",
      "enabled": false,
      "credentials": {},
      "options": {
        "providerId": "custom-a",
        "endpoint": "https://your-gateway.example.com/api/usage",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer ${CUSTOM_API_KEY}"
        },
        "mapping": {
          "wrap": "data",
          "balance": { "path": "remaining", "currency": "USD" },
          "creditLots": {
            "path": "grants",
            "amount": "remaining",
            "expiresAt": "expiresAt",
            "label": "name",
            "currency": "USD"
          }
        }
      }
    },
    {
      "provider": "demo:no-expiry",
      "displayName": "示例 · 无过期时间",
      "enabled": false,
      "credentials": {},
      "options": {}
    }
  ]
}
